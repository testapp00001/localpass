{
  "manifest_version": 3,
  "name": "LocalPass",
  "version": "0.2.0",
  "description": "Fill passwords and passkeys from your LocalPass vault. Everything stays on your own devices.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "permissions": ["nativeMessaging", "storage", "activeTab", "privacy"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LocalPass",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://*.localhost/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://*.localhost/*"],
      "js": ["inject.js"],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}

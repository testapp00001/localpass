{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalPass",
  "version": "0.2.0",
  "identifier": "app.localpass",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalPass",
        "width": 1100,
        "height": 740,
        "minWidth": 360,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Fully local password manager with LAN sync",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

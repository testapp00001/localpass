<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.localpass" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/lp_background</item>
    </style>
    <!-- The screens credential services show over another app: no window of their own, just dialogs. -->
    <style name="Theme.localpass.Provider" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
